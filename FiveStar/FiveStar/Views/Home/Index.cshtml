@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model FiveStars.Models.HomeIndexViewModel

<div class="main-movie-screen">
    <div class="trailer-content">
        <video class="trailer-video" muted loop playsinline>
            <source src="@Url.Content("~/videos/main-trailer.mp4")" type="video/mp4" />
            <img src="@Url.Content("~/images/Gemini_Generated_Image_50urx450urx450ur.jpg")"
                 alt="Trailer Poster" class="trailer-poster" />
        </video>

        <div class="play-overlay">
            <a href="#" class="play-button" aria-label="Play/Pause Trailer" id="play-pause-button">
                <i class="fas fa-play"></i>
            </a>
        </div>

        <!-- Hero butonu: Movies/Index'e götürüyor -->
        <a href="@Url.Action("Index", "Movies")" class="buy-ticket-btn">
            BUY TICKETS NOW
        </a>
    </div>
</div>

<div class="movie-listings-panel">

    <!-- NOW SHOWING -->
    <section class="section-now-showing">
        <h2>NOW SHOWING</h2>

        <div class="movie-carousel-wrapper">
            <button class="scroll-btn left" onclick="scrollCarousel('now-showing-carousel', -250)">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="movie-carousel" id="now-showing-carousel">

                @foreach (var item in Model.NowShowing)
                {
                    var m = item.Movie;

                    var poster = Url.Content("~/" + (
                        string.IsNullOrWhiteSpace(m.PosterUrl)
                            ? "images/default-poster.jpg"
                            : m.PosterUrl.TrimStart('~', '/')
                    ));

                    <div class="movie-item-now-showing">
                        <a href="@Url.Action("Details", "Movies", new { id = m.MovieID })" class="movie-link">
                            <img src="@poster" alt="@m.Title" />
                            <p>@m.Title</p>
                        </a>

                        <button class="book-now-btn"
                                onclick="window.location.href='@Url.Action("Details", "Movies", new { id = m.MovieID })'">
                            BOOK NOW
                        </button>

                        
                    </div>
                }

            </div>

            <button class="scroll-btn right" onclick="scrollCarousel('now-showing-carousel', 250)">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </section>


    <!-- TOP 10 -->
    <section class="section-trailers">
        <h2>TOP 10</h2>
        <div class="movie-carousel-wrapper">
            <button class="scroll-btn left" onclick="scrollCarousel('trailers-carousel', -220)">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="movie-carousel" id="trailers-carousel">
                @foreach (var t in Model.Top10)
                {
                    var m = t.Movie;

                    var poster = Url.Content("~/" + (
                        string.IsNullOrWhiteSpace(m.PosterUrl)
                            ? "images/default-poster.jpg"
                            : m.PosterUrl.TrimStart('~', '/')
                    ));

                    <div class="movie-item">
                        <a href="@Url.Action("Details", "Movies", new { id = m.MovieID })" class="movie-link">
                            <img src="@poster" alt="@m.Title" />
                            
                            <p>@t.RankOrder. @m.Title</p>
                        </a>

                        @* Ratings alanın DB’de  *@
                        @if (m.Ratings != null)
                        {
                            <div class="rating">⭐ @m.Ratings/10</div>
                        }
                    </div>
                }
            </div>

            <button class="scroll-btn right" onclick="scrollCarousel('trailers-carousel', 220)">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </section>


    <!-- Campaigns Section -->
    <section class="section-campaigns">
        <div class="section-header">
            <h2>CAMPAIGNS</h2>
            <a href="@Url.Action("Index", "Campaigns")" class="see-all-btn">
                SEE ALL <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <div class="movie-carousel-wrapper">
            <button class="scroll-btn left" onclick="scrollCarousel('campaigns-carousel', -240)">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="movie-carousel" id="campaigns-carousel">
                @foreach (var c in Model.Campaigns)
                {
                    var img = Url.Content("~/" + (
                        string.IsNullOrWhiteSpace(c.ImageUrl)
                            ? "images/campaign_default.jpg"
                            : c.ImageUrl.TrimStart('~', '/')
                    ));

                    <a class="campaign-item campaign-link"
                       href="@Url.Action("Index", "Campaigns")"
                       title="@c.Title">
                        <img src="@img" alt="@c.Title" />
                        <div class="campaign-duration">@c.DurationText</div>

                        <!-- İsim de tıklanabilir, çünkü aynı <a> içinde -->
                        <p>@c.Title</p>
                    </a>
                }
            </div>

            <button class="scroll-btn right" onclick="scrollCarousel('campaigns-carousel', 240)">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </section>


    <!-- COMING SOON (DB) -->
    <section class="section-yakinda">
        <div class="section-header">
            <h2>COMING SOON</h2>
            <a href="@Url.Action("Index", "Movies")" class="see-all-btn">
                SEE ALL <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <div class="movie-carousel-wrapper">
            <button class="scroll-btn left" onclick="scrollCarousel('yakinda-carousel', -220)">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="movie-carousel" id="yakinda-carousel">
                @foreach (var m in Model.ComingSoon)
                {
                    var poster = Url.Content("~/" + (
                        string.IsNullOrWhiteSpace(m.PosterUrl)
                            ? "images/default-poster.jpg"
                            : m.PosterUrl.TrimStart('~', '/')
                    ));

                    var dateText = m.ReleaseDate.HasValue
                        ? m.ReleaseDate.Value.ToString("MMM d").ToUpper()
                        : "COMING SOON";

                    <div class="movie-item-yakinda">
                        <a href="@Url.Action("Details", "Movies", new { id = m.MovieID })" class="movie-link">
                            <img src="@poster" alt="@m.Title" />
                            <div class="overlay" data-date="@dateText">
                                @m.Title
                            </div>
                        </a>
                    </div>
                }
            </div>

            <button class="scroll-btn right" onclick="scrollCarousel('yakinda-carousel', 220)">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </section>


    <!-- LAST WEEK'S MOVIES -->
    <section class="section-last-weeks">
        <h2>LAST WEEK'S MOVIES</h2>
        <div class="movie-carousel-wrapper">
            <button class="scroll-btn left" onclick="scrollCarousel('last-weeks-carousel', -220)">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="movie-carousel" id="last-weeks-carousel">
                @foreach (var m in Model.LastWeek)
                {
                    var poster = Url.Content("~/" + (
                        string.IsNullOrWhiteSpace(m.PosterUrl)
                            ? "images/default-poster.jpg"
                            : m.PosterUrl.TrimStart('~', '/')
                    ));

                    <div class="movie-item">
                        <a href="@Url.Action("Details", "Movies", new { id = m.MovieID })" class="movie-link">
                            <img src="@poster" alt="@m.Title" />
                            
                            <p>@m.Title</p>
                        </a>

                        @if (m.Ratings != null)
                        {
                            <div class="rating">⭐ @m.Ratings/10</div>
                        }
                    </div>
                }
            </div>

            <button class="scroll-btn right" onclick="scrollCarousel('last-weeks-carousel', 220)">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </section>


</div>
