@model FiveStars.Models.PaymentViewModel
@{
    ViewBag.Title = "Ödeme Başarılı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="success-container">
    <i class="fas fa-check-circle success-icon"></i>
    <h2>Your payment process has been successfully completed!</h2>
    <p class="success-message-text">
        Your tickets have been sent to your registered email address.
    </p>

    @* Model kontrolü ve sipariş detaylarının gösterilmesi *@
    @if (Model != null)
    {
        <div class="success-details-box">
            <h4>Order Details</h4>
            <div class="detail-line">
                <span>Order Number:</span>
                <strong>@Model.OrderID</strong>
            </div>
            <div class="detail-line">
                <span>Amount Paid:</span>
                <strong class="final-total-success">@Model.FinalTotal.ToString("C")</strong>
            </div>
        </div>
    }

    <div class="mt-4">
        <a href="@Url.Action("Index", "Home")" class="success-btn">Ana Sayfaya Dön</a>
    </div>
</div>


<style>
    /* Başarı Sayfası Stillerimiz*/
    .success-container {
        max-width: 450px;
        margin: 100px auto;
        text-align: center;
        background: #1A1A1A; /* Koyu Arkaplan */
        padding: 40px;
        border-radius: 14px;
        box-shadow: 0 0 25px rgba(0,0,0,0.6);
        color: white;
    }

    .success-icon {
        font-size: 60px;
        color: #4CAF50; /* Yeşil onay rengi */
        margin-bottom: 20px;
    }

    .success-message-text {
        color: #BBB;
        margin-bottom: 30px;
    }

    .success-details-box {
        background-color: #282828;
        padding: 20px;
        border-radius: 8px;
        margin-top: 20px;
        margin-bottom: 20px;
        border: 1px solid #3A3A3A;
        text-align: left;
    }

        .success-details-box h4 {
            color: #E50914; /* Kırmızı vurgu */
            margin-top: 0;
            padding-bottom: 10px;
            border-bottom: 1px solid #3A3A3A;
        }

    .detail-line {
        display: flex;
        justify-content: space-between;
        padding: 5px 0;
    }

    .final-total-success {
        color: #4CAF50; /* Yeşil Final Tutar */
        font-size: 1.1em;
    }

    .success-btn {
        display: inline-block;
        padding: 12px 25px;
        background: #E50914; /* Kırmızı Ana Buton */
        color: white;
        font-weight: bold;
        border-radius: 8px;
        text-decoration: none;
        transition: background-color 0.3s;
        font-size: 1em;
    }

        .success-btn:hover {
            background: #B20710;
        }
</style>