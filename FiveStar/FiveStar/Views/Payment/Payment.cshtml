@model FiveStars.Models.PaymentViewModel
@{
    ViewBag.Title = "Payment Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Temel Stil Düzeltmeleri */
    .payment-container {
        max-width: 1200px;
        margin: 50px auto;
        color: #E0E0E0;
        background-color: #1A1A1A;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
    }

    .booking-details-box {
        background-color: #282828;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
    }

    .summary-box {
        background-color: #282828;
        padding: 25px;
        border-radius: 8px;
        border: 1px solid #3A3A3A;
        margin-top: 30px;
    }

    .final-total {
        color: #4CAF50;
        font-size: 2em;
        font-weight: bold;
    }

    .discount-amount {
        color: #FF5252;
        font-weight: bold;
    }

    .btn-confirm {
        background-color: #E50914;
        border: none;
        font-size: 1.2em;
        padding: 15px 0;
        transition: background-color 0.3s;
    }

        .btn-confirm:hover {
            background-color: #B20710;
            color: white;
        }

    .form-control {
        background-color: #3A3A3A;
        color: #E0E0E0;
        border: 1px solid #555;
    }

        .form-control:focus {
            background-color: #3A3A3A;
            border-color: #E50914;
            box-shadow: 0 0 0 0.2rem rgba(229, 9, 20, 0.25);
        }

    /* Campaign Picker UI */
    .campaign-picker {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .campaign-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 14px 16px;
        border-radius: 10px;
        background: #282828;
        border: 1px solid #3A3A3A;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .campaign-option:hover {
            border-color: #E50914;
            box-shadow: 0 0 0 3px rgba(229, 9, 20, 0.15);
            transform: translateY(-1px);
        }

        .campaign-option input[type="radio"] {
            accent-color: #E50914;
            transform: scale(1.15);
        }

    .campaign-option-body {
        flex: 1;
    }

    .campaign-option-title {
        color: #fff;
        font-weight: 700;
        font-size: 16px;
        line-height: 1.2;
    }

    .campaign-option-sub {
        color: #b5b5b5;
        font-size: 13px;
        margin-top: 4px;
    }

    .campaign-option-badge {
        font-size: 12px;
        font-weight: 800;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(229, 9, 20, 0.15);
        border: 1px solid rgba(229, 9, 20, 0.35);
        color: #ffb3b6;
        white-space: nowrap;
    }

    /* Selected State */
    .campaign-option.selected {
        border-color: #E50914;
        background: linear-gradient(180deg, rgba(229, 9, 20, 0.12), rgba(40, 40, 40, 1));
    }

    /* Empty campaigns message */
    .empty-campaign-box {
        background: #282828;
        border: 1px dashed #555;
        color: #FFD700;
        padding: 14px 16px;
        border-radius: 10px;
    }

</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="payment-container">
    <h1 class="mb-5" style="color: white;">Payment Confirmation</h1>

    @using (Html.BeginForm("ConfirmPayment", "Payment", FormMethod.Post, new { id = "payment-form" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.OrderID)
        @Html.HiddenFor(m => m.SelectedCampaignID)

        @* --- 1. BOOKING DETAILS --- *@
        <div class="booking-details-box">
            <h4>Booking Details</h4>

            @if (Model.SelectedSeats != null && Model.SelectedSeats.Any())
            {
                <p>
                    <strong>Selected Seats:</strong>
                    <span style="font-size: 1.1em;">@string.Join(", ", Model.SelectedSeats)</span>
                </p>
            }
            <p>
                <strong>Base Total (Undiscounted):</strong>
                <span id="base-total" style="font-size: 1.1em; font-weight: bold;">@Model.BaseTotal.ToString("C")</span>
            </p>
        </div>

        @* --- 2. CAMPAIGN SELECTION --- *@
        <div class="form-group mb-5">
            <h4 style="color:white; margin-bottom: 12px;">My Campaigns</h4>
            <p style="color:#aaa; margin-top:-6px; margin-bottom: 16px;">
                Select one campaign to apply (or continue without a campaign).
            </p>

            @if (Model.AvailableCampaigns != null && Model.AvailableCampaigns.Any())
            {
                <div class="campaign-picker">

                    <!-- No campaign option -->
                    <label class="campaign-option selected" data-cid="0">
                        <input type="radio" name="campaign-choice" value="0" checked />
                        <div class="campaign-option-body">
                            <div class="campaign-option-title">No campaign</div>
                            <div class="campaign-option-sub">Pay the normal price</div>
                        </div>
                    </label>

                    @foreach (var c in Model.AvailableCampaigns)
                    {
                        <label class="campaign-option" data-cid="@c.CampaignID">
                            <input type="radio" name="campaign-choice" value="@c.CampaignID" />
                            <div class="campaign-option-body">
                                <div class="campaign-option-title">@c.Title</div>
                                <div class="campaign-option-sub">Use this campaign for your order</div>
                            </div>
                            <div class="campaign-option-badge">APPLY</div>
                        </label>
                    }
                </div>
            }
            else
            {
                <div class="empty-campaign-box">
                    You don't have any active campaigns saved.
                </div>
            }
        </div>


        <hr style="border-color: #3A3A3A;" />

        @* --- 3. PAYMENT SUMMARY --- *@
        <div class="summary-box">
            <h4>Payment Summary</h4>
            <p>
                Discount Applied:
                <span id="discount-amount" class="discount-amount">@Model.DiscountAmount.ToString("C")</span>
            </p>
            <h3 class="mt-3">
                Final Total Payable:
                <span id="final-total" class="final-total">@Model.FinalTotal.ToString("C")</span>
            </h3>
        </div>

        @* --- 4. CREDIT CARD INFO (Simülasyon) --- *@
        <div class="my-4 p-3 bg-dark" style="border-radius: 5px;">
            <h5 style="color: #bbb;">Credit Card Information (Simulation)</h5>
            <p style="font-size: 0.9em; color: #999;">
                By clicking 'Confirm Payment', the Controller will assume the payment is successful.
            </p>
        </div>

        @* --- 5. SUBMIT BUTTON --- *@
        <div class="mt-4">
            <button type="submit" class="btn btn-lg btn-confirm w-100">
                CONFIRM PAYMENT AND ISSUE TICKET
            </button>
        </div>

        @Html.ValidationSummary(true, "", new { @class = "text-danger mt-3" })
    }
</div>

@* ========================================================================= *@
@* JAVASCRIPT / AJAX FUNCTIONALITY *@
@* ========================================================================= *@
<script>

$(document).ready(function () {

    function setSelectedCampaignCard(campaignId) {
        $('.campaign-option').removeClass('selected');
        $('.campaign-option[data-cid="' + campaignId + '"]').addClass('selected');
    }

    $(document).on('change', 'input[name="campaign-choice"]', function () {
        var selectedCampaignId = $(this).val();
        var campaignIdToSend = selectedCampaignId || 0;
        var orderId = $('#OrderID').val();

        setSelectedCampaignCard(campaignIdToSend);

        $.ajax({
            url: '@Url.Action("RecalculatePrice", "Payment")',
            type: 'POST',
            data: {
                orderId: orderId,
                campaignId: campaignIdToSend
            },
            success: function (response) {
                if (response.success) {
                    $('#discount-amount').text(response.discount);
                    $('#final-total').text(response.finalTotal);
                    $('#SelectedCampaignID').val(response.selectedCampaignId);
                } else {
                    alert("Campaign cannot be applied: " + response.message);

                    // Reset UI to "No campaign"
                    $('input[name="campaign-choice"][value="0"]').prop('checked', true);
                    setSelectedCampaignCard("0");

                    $('#discount-amount').text(response.discount);
                    $('#final-total').text(response.finalTotal);
                    $('#SelectedCampaignID').val('');
                }
            },
            error: function (xhr, status, error) {
                console.error("Ajax Error:", status, error);
                alert("An unexpected server communication error occurred. Check the console for details.");
            }
        });
    });

    // Ensure initial selected state looks correct
    setSelectedCampaignCard("0");
});


</script>