@model FiveStars.Models.PaymentViewModel
@{
    ViewBag.Title = "Payment Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Temel Stil Düzeltmeleri */
    .payment-container {
        max-width: 1200px;
        margin: 50px auto;
        color: #E0E0E0;
        background-color: #1A1A1A;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
    }

    .booking-details-box, .summary-box, .payment-card-info {
        background-color: #282828;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
        border: 1px solid #3A3A3A;
    }

    .summary-box {
        padding: 25px;
        margin-top: 30px;
    }

        .summary-box h4 {
            color: #E50914;
            margin-bottom: 15px;
        }

    .final-total {
        color: #4CAF50;
        font-size: 2em;
        font-weight: bold;
    }

    .discount-amount {
        color: #FF5252;
        font-weight: bold;
    }

    .btn-confirm {
        background-color: #E50914;
        border: none;
        font-size: 1.2em;
        padding: 15px 0;
        transition: background-color 0.3s;
    }

        .btn-confirm:hover {
            background-color: #B20710;
            color: white;
        }

    .form-control {
        background-color: #3A3A3A;
        color: #E0E0E0;
        border: 1px solid #555;
        padding: 10px;
        width: 100%;
        box-sizing: border-box;
    }

        .form-control:focus {
            background-color: #3A3A3A;
            border-color: #E50914;
            box-shadow: 0 0 0 0.2rem rgba(229, 9, 20, 0.25);
        }

    .form-group-custom {
        margin-bottom: 15px;
    }

    .form-row-custom {
        display: flex;
        gap: 15px;
    }

    /* ========== SIMPLIFIED CAMPAIGN SECTION ========== */
    .campaign-section {
        background: linear-gradient(145deg, #1e1e1e, #252525);
        border-radius: 16px;
        padding: 30px;
        margin-bottom: 30px;
        border: 1px solid #333;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #E50914;
    }

    .section-icon {
        color: #E50914;
        font-size: 24px;
    }

    .section-title {
        color: white;
        font-size: 24px;
        font-weight: 700;
        margin: 0;
    }

    .section-subtitle {
        color: #aaa;
        font-size: 14px;
        margin-top: 5px;
        margin-bottom: 25px;
    }

    /* Campaign Cards Grid */
    .campaign-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
        margin-bottom: 25px;
    }

    /* Campaign Card */
    .campaign-card {
        background: linear-gradient(145deg, #2a2a2a, #222);
        border-radius: 12px;
        padding: 20px;
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

        .campaign-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(229, 9, 20, 0.15);
        }

        .campaign-card.selected {
            border-color: #E50914;
            background: linear-gradient(145deg, #2a2a2a, rgba(229, 9, 20, 0.1));
            box-shadow: 0 8px 24px rgba(229, 9, 20, 0.2);
        }

        .campaign-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #E50914, #ff4757);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .campaign-card.selected::before {
            opacity: 1;
        }

    /* Card Header */
    .campaign-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 15px;
    }

    .campaign-card-title {
        color: white;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.3;
        margin: 0;
        flex: 1;
    }

    .campaign-card-badge {
        background: linear-gradient(135deg, #E50914, #ff6b6b);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
        margin-left: 10px;
    }

    .campaign-card.selected .campaign-card-badge {
        background: linear-gradient(135deg, #4CAF50, #66BB6A);
    }

    /* Card Body */
    .campaign-card-body {
        margin-bottom: 15px;
    }

    .campaign-card-description {
        color: #bbb;
        font-size: 14px;
        line-height: 1.5;
        margin-bottom: 10px;
        min-height: 40px;
    }

    /* Card Footer */
    .campaign-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 15px;
        border-top: 1px solid #333;
    }

    .campaign-card-type {
        background: rgba(255, 255, 255, 0.1);
        color: #ddd;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .campaign-card-radio {
        accent-color: #E50914;
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    /* No Campaigns State */
    .no-campaigns-state {
        text-align: center;
        padding: 40px 20px;
        background: linear-gradient(145deg, #2a2a2a, #222);
        border-radius: 12px;
        border: 2px dashed #444;
    }

    .no-campaigns-icon {
        font-size: 48px;
        color: #666;
        margin-bottom: 20px;
    }

    .no-campaigns-title {
        color: #ccc;
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .no-campaigns-message {
        color: #888;
        font-size: 14px;
        max-width: 400px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* Campaign Stats */
    .campaign-stats {
        display: flex;
        gap: 20px;
        background: rgba(255, 255, 255, 0.05);
        padding: 15px;
        border-radius: 10px;
        margin-top: 20px;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
    }

    .stat-value {
        color: #E50914;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #aaa;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .campaign-cards-grid {
            grid-template-columns: 1fr;
        }

        .campaign-card-header {
            flex-direction: column;
            gap: 10px;
        }

        .campaign-card-badge {
            align-self: flex-start;
        }

        .form-row-custom {
            flex-direction: column;
        }
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="payment-container">
    <h1 class="mb-5" style="color: white;">Payment Confirmation</h1>

    @using (Html.BeginForm("ConfirmPayment", "Payment", FormMethod.Post, new { id = "payment-form" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.OrderID)
        @* --- DÜZELTİLMİŞ GİZLİ INPUT --- *@
        @Html.HiddenFor(m => m.SelectedCampaignID, new { id = "SelectedCampaignID" })

        @* --- 1. BOOKING DETAILS --- *@
        <div class="booking-details-box">
            <h4>Booking Details</h4>

            @if (Model.SelectedSeats != null && Model.SelectedSeats.Any())
            {
                <p>
                    <strong>Selected Seats:</strong>
                    <span style="font-size: 1.1em;">@string.Join(", ", Model.SelectedSeats)</span>
                </p>
            }
            <p>
                <strong>Base Total (Undiscounted):</strong>
                <span id="base-total" style="font-size: 1.1em; font-weight: bold;">@Model.BaseTotal.ToString("C")</span>
            </p>
        </div>

        @* --- 2. ULTRA-SIMPLIFIED CAMPAIGN SELECTION --- *@
        <div class="campaign-section">
            <div class="section-header">
                <i class="fas fa-tags section-icon"></i>
                <div>
                    <h2 class="section-title">Your Campaigns</h2>
                    <p class="section-subtitle">
                        Select one of your available campaigns to apply discount to your order
                    </p>
                </div>
            </div>

            @if (Model.AvailableCampaigns != null && Model.AvailableCampaigns.Any())
            {
                <div class="campaign-cards-grid">
                    <div class="campaign-card selected" data-cid="0">
                        <div class="campaign-card-header">
                            <h3 class="campaign-card-title">No Campaign</h3>
                            <span class="campaign-card-badge">DEFAULT</span>
                        </div>
                        <div class="campaign-card-body">
                            <p class="campaign-card-description">
                                Continue with standard pricing. Your order will be processed without any discounts applied.
                            </p>
                        </div>
                        <div class="campaign-card-footer">
                            <span class="campaign-card-type">Standard Price</span>
                            <input type="radio" name="campaign-choice" value="0" class="campaign-card-radio" checked />
                        </div>
                    </div>

                    @foreach (var c in Model.AvailableCampaigns)
                    {
                        // Get discount info and campaign type from title
                        var discountInfo = GetDiscountInfoFromTitle(c.Title);
                        var campaignType = GetCampaignTypeFromTitle(c.Title);
                        var campaignIcon = GetCampaignIcon(campaignType);

                        <div class="campaign-card" data-cid="@c.CampaignID">
                            <div class="campaign-card-header">
                                <h3 class="campaign-card-title">@c.Title</h3>
                                <span class="campaign-card-badge">@discountInfo</span>
                            </div>
                            <div class="campaign-card-body">
                                <p class="campaign-card-description">
                                    @GetCampaignDescription(c.CampaignID, c.Title)
                                </p>
                            </div>
                            <div class="campaign-card-footer">
                                <span class="campaign-card-type">
                                    <i class="fas @campaignIcon"></i> @campaignType
                                </span>
                                <input type="radio" name="campaign-choice" value="@c.CampaignID" class="campaign-card-radio" />
                            </div>
                        </div>
                    }
                </div>

                <div class="campaign-stats">
                    <div class="stat-item">
                        <span class="stat-value">@Model.AvailableCampaigns.Count</span>
                        <span class="stat-label">Available</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value" id="campaigns-used">0</span>
                        <span class="stat-label">Will Be Used</span>
                    </div>
                </div>
            }
            else
            {
                <div class="no-campaigns-state">
                    <i class="fas fa-tag no-campaigns-icon"></i>
                    <h3 class="no-campaigns-title">No Campaigns Available</h3>
                    <p class="no-campaigns-message">
                        You don't have any active campaigns in your profile.
                        Check your email or profile page for new campaign offers.
                    </p>
                </div>
            }
        </div>

        <hr style="border-color: #3A3A3A;" />

        @* --- 3. PAYMENT SUMMARY --- *@
        <div class="summary-box">
            <h4>Payment Summary</h4>
            <p>
                Discount Applied:
                <span id="discount-amount" class="discount-amount">@Model.DiscountAmount.ToString("C")</span>
            </p>
            <h3 class="mt-3">
                Final Total Payable:
                <span id="final-total" class="final-total">@Model.FinalTotal.ToString("C")</span>
            </h3>
        </div>

        @* --- 4. CREDIT CARD INFO (Form Inputları Eklendi) --- *@
        <div class="payment-card-info mt-4">
            <h5 style="color: #bbb;">Credit Card Information</h5>

            <div class="form-group-custom">
                <label for="CardHolderName">Card Holder Name</label>
                <input type="text" id="CardHolderName" name="CardHolderName" class="form-control" required placeholder="Card Holder Name" />
            </div>

            <div class="form-group-custom">
                <label for="CardNumber">Card Number</label>
                <input type="text" id="CardNumber" name="CardNumber" class="form-control" required placeholder="XXXX XXXX XXXX XXXX" maxlength="19" />
            </div>

            <div class="form-row-custom">
                <div class="form-group-custom w-50">
                    <label for="ExpirationDate">Expiration Date (MM/YY)</label>
                    <input type="text" id="ExpirationDate" name="ExpirationDate" class="form-control" required placeholder="MM/YY" maxlength="5" />
                </div>
                <div class="form-group-custom w-50">
                    <label for="Cvv">CVV</label>
                    <input type="password" id="Cvv" name="Cvv" class="form-control" required placeholder="***" maxlength="4" />
                </div>
            </div>

            <p style="font-size: 0.9em; color: #999; margin-top: 15px;">
                By clicking 'Confirm Payment', the Controller will assume the payment is successful.
            </p>
        </div>

        @* --- 5. SUBMIT BUTTON --- *@
        <div class="mt-4">
            <button type="submit" class="btn btn-lg btn-confirm w-100">
                <i class="fas fa-lock me-2"></i> CONFIRM PAYMENT AND ISSUE TICKET
            </button>
        </div>

        @Html.ValidationSummary(true, "", new { @class = "text-danger mt-3" })
    }
</div>

@* ========================================================================= *@
@* RAZOR @functions (Kalan Kısım) *@
@* ========================================================================= *@
@functions {
    // Helper function to get discount info from title
    public string GetDiscountInfoFromTitle(string title)
    {
        if (string.IsNullOrEmpty(title))
            return "OFFER";

        var match = System.Text.RegularExpressions.Regex.Match(title, @"(\d{1,3})%", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (match.Success)
            return "-" + match.Groups[1].Value + "%";

        if (title.ToLower().Contains("20%"))
            return "-20%";
        else if (title.ToLower().Contains("discount"))
            return "DISCOUNT";

        return "OFFER";
    }

    // Helper function to get campaign type from title
    public string GetCampaignTypeFromTitle(string title)
    {
        if (string.IsNullOrEmpty(title))
            return "Special";

        string titleLower = title.ToLower();

        if (titleLower.Contains("family"))
            return "Family";
        else if (titleLower.Contains("couple") || titleLower.Contains("valentine"))
            return "Couple";
        else if (titleLower.Contains("tuesday") || titleLower.Contains("weekday"))
            return "Tuesday";
        else if (titleLower.Contains("student"))
            return "Student";
        else if (titleLower.Contains("popcorn"))
            return "Popcorn";
        else if (titleLower.Contains("seasonal"))
            return "Seasonal";
        else
            return "Special";
    }

    // Helper function to get icon for campaign type
    public string GetCampaignIcon(string type)
    {
        switch (type.ToLower())
        {
            case "student":
                return "fa-graduation-cap";
            case "family":
                return "fa-users";
            case "tuesday":
            case "weekday":
                return "fa-calendar-day";
            case "popcorn":
                return "fa-popcorn";
            case "couple":
            case "valentine":
                return "fa-heart";
            case "seasonal":
                return "fa-snowflake";
            default:
                return "fa-tag";
        }
    }

    // Helper function to get campaign description based on ID and title
    public string GetCampaignDescription(int campaignId, string title)
    {
        switch (campaignId)
        {
            case 2: // Family Package
                return "Buy 4 tickets, pay for 3. Perfect for family outings.";
            case 3: // Tuesday Cinema
                return "Special discount valid only on Tuesdays. Save on your weekday movie.";
            case 5: // Couple Ticket
                return "Special offer for couples. Book exactly 2 tickets.";
            default:
                if (!string.IsNullOrEmpty(title) && title.ToLower().Contains("discount"))
                    return "Apply this discount to your order.";
                else
                    return "Apply this special offer to your order.";
        }
    }
}

@* ========================================================================= *@
@* JAVASCRIPT / AJAX FUNCTIONALITY (Kalan Kısım) *@
@* ========================================================================= *@
<script>
$(document).ready(function () {

    function setSelectedCampaignCard(campaignId) {
        $('.campaign-card').removeClass('selected');
        $('.campaign-card[data-cid="' + campaignId + '"]').addClass('selected');

        if (campaignId !== "0") {
            $('#campaigns-used').text('1');
        } else {
            $('#campaigns-used').text('0');
        }
    }

    // Click handler for campaign cards
    $(document).on('click', '.campaign-card', function () {
        var campaignId = $(this).data('cid');
        var radio = $(this).find('input[type="radio"]');
        radio.prop('checked', true).trigger('change');
    });

    $(document).on('change', 'input[name="campaign-choice"]', function () {
        var selectedCampaignId = $(this).val();
        var campaignIdToSend = selectedCampaignId || 0;
        var orderId = $('#OrderID').val();

        // First update the visual selection
        setSelectedCampaignCard(campaignIdToSend);

        // Then make AJAX call for price calculation
        $.ajax({
            url: '@Url.Action("RecalculatePrice", "Payment")',
            type: 'POST',
            data: {
                orderId: orderId,
                campaignId: campaignIdToSend
            },
            success: function (response) {
                console.log('AJAX Response:', response);
                if (response.success) {
                    $('#discount-amount').text(response.discount);
                    $('#final-total').text(response.finalTotal);
                    $('#SelectedCampaignID').val(response.selectedCampaignId);

                    // Add visual feedback
                    var finalTotalElement = $('#final-total');
                    finalTotalElement.addClass('pulse-animation');
                    setTimeout(function() {
                        finalTotalElement.removeClass('pulse-animation');
                    }, 500);

                } else {
                    alert('Campaign Not Applicable: ' + response.message);

                    // Reset UI to "No campaign"
                    $('input[name="campaign-choice"][value="0"]').prop('checked', true);
                    setSelectedCampaignCard("0");

                    $('#discount-amount').text(response.discount);
                    $('#final-total').text(response.finalTotal);
                    $('#SelectedCampaignID').val('');
                }
            },
            error: function (xhr, status, error) {
                console.error("Ajax Error:", status, error);
                alert('Server Error: An unexpected error occurred. Please try again.');
            }
        });
    });

    // Add pulse animation CSS
    $('<style>.pulse-animation { animation: pulse 0.5s ease-in-out; }@@keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }</style>').appendTo('head');

    // Ensure initial selected state looks correct
    setSelectedCampaignCard('@(Model.SelectedCampaignID.HasValue && Model.SelectedCampaignID.Value > 0 ? Model.SelectedCampaignID.Value.ToString() : "0")');
});
</script>