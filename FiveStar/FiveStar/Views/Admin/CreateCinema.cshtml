@model FiveStars.Models.ViewModels.CinemaWithHallsVM
@{
    ViewBag.Title = "Create New Cinema";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">CREATE NEW CINEMA</h1>
        <a href="@Url.Action("Cinemas", "Admin")" class="back-link">
            <i class="fas fa-arrow-left"></i> Back to Cinemas
        </a>
    </div>

    <div class="form-container">
        @using (Html.BeginForm("CreateCinema", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)

            <div class="form-group">
                <label class="form-label">Cinema Name *</label>
                @Html.TextBoxFor(m => m.CinemaName, new { @class = "form-control", placeholder = "Enter cinema name" })
                @Html.ValidationMessageFor(m => m.CinemaName, "", new { style = "color:#dc3545; font-size:12px;" })
            </div>

            <div class="form-group">
                <label class="form-label">Address *</label>
                @Html.TextAreaFor(m => m.Address, new { @class = "form-control", placeholder = "Enter cinema address...", rows = 3 })
                @Html.ValidationMessageFor(m => m.Address, "", new { style = "color:#dc3545; font-size:12px;" })
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">City *</label>
                    @Html.TextBoxFor(m => m.City, new { @class = "form-control", placeholder = "City" })
                    @Html.ValidationMessageFor(m => m.City, "", new { style = "color:#dc3545; font-size:12px;" })
                </div>

                <div class="form-group">
                    <label class="form-label">District *</label>
                    @Html.TextBoxFor(m => m.District, new { @class = "form-control", placeholder = "District" })
                    @Html.ValidationMessageFor(m => m.District, "", new { style = "color:#dc3545; font-size:12px;" })
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Phone Number *</label>
                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+90 555 123 45 67" })
                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { style = "color:#dc3545; font-size:12px;" })
            </div>

            <hr />

            <div class="admin-header" style="margin-top:10px;">
                <h2 class="admin-title" style="font-size:18px;">HALLS</h2>
                <button type="button" id="addHallBtn" class="btn btn-success">
                    + Add Hall
                </button>
            </div>

            <div id="hallsContainer">
                @for (int i = 0; i < Model.Halls.Count; i++)
                {
                    <div class="hall-row" data-index="@i">
                        @Html.HiddenFor(m => m.Halls[i].HallID)
                        @Html.HiddenFor(m => m.Halls[i].IsDeleted, new { @class = "is-deleted" })

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Hall Type</label>
                                @Html.DropDownListFor(m => m.Halls[i].HallType,
                                    new SelectList(new[] { "Standard", "VIP", "IMAX" }, Model.Halls[i].HallType),
                                    new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Halls[i].HallType, "", new { style = "color:#dc3545; font-size:12px;" })
                            </div>

                            <div class="form-group">
                                <label class="form-label">Capacity</label>
                                @Html.TextBoxFor(m => m.Halls[i].Capacity, new { @class = "form-control", type = "number", min = "1", max = "1000" })
                                @Html.ValidationMessageFor(m => m.Halls[i].Capacity, "", new { style = "color:#dc3545; font-size:12px;" })
                            </div>

                            <div class="form-group" style="display:flex; align-items:flex-end;">
                                <button type="button" class="btn btn-danger js-remove-hall">Remove</button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Cinema
                </button>
                <a href="@Url.Action("Cinemas", "Admin")" class="btn btn-secondary">Cancel</a>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
(function () {
    var hallsContainer = document.getElementById('hallsContainer');
    var addBtn = document.getElementById('addHallBtn');

    var hallIndex = @Model.Halls.Count;

    function hallHtml(i) {
        return `
<div class="hall-row" data-index="${i}">
  <input type="hidden" name="Halls[${i}].HallID" value="0" />
  <input type="hidden" name="Halls[${i}].IsDeleted" value="false" class="is-deleted" />

  <div class="form-row">
    <div class="form-group">
      <label class="form-label">Hall Type</label>
      <select name="Halls[${i}].HallType" class="form-control">
        <option value="Standard">Standard</option>
        <option value="VIP">VIP</option>
        <option value="IMAX">IMAX</option>
      </select>
    </div>

    <div class="form-group">
      <label class="form-label">Capacity</label>
      <input type="number" name="Halls[${i}].Capacity" class="form-control" min="1" max="1000" value="120" />
    </div>

    <div class="form-group" style="display:flex; align-items:flex-end;">
      <button type="button" class="btn btn-danger js-remove-hall">Remove</button>
    </div>
  </div>
</div>`;
    }

    addBtn.addEventListener('click', function () {
        hallsContainer.insertAdjacentHTML('beforeend', hallHtml(hallIndex));
        hallIndex++;
    });

    hallsContainer.addEventListener('click', function (e) {
        if (!e.target.classList.contains('js-remove-hall')) return;

        var row = e.target.closest('.hall-row');
        if (!row) return;

        // yeni eklenen satırsa direkt sil
        var isNew = row.querySelector('input[name$=".HallID"]')?.value === "0";
        if (isNew) {
            row.remove();
            return;
        }

        // eski satırsa IsDeleted=true yap
        var del = row.querySelector('.is-deleted');
        if (del) del.value = "true";
        row.style.display = "none";
    });
})();
    </script>
}
