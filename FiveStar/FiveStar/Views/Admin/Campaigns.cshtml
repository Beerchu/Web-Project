@model IEnumerable<FiveStars.Models.Campaigns>

@{
    ViewBag.Title = "Campaign Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Campaign Management</h1>
        <a href="@Url.Action("Index", "Admin")" class="back-link">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert success">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="action-buttons">
        <a href="@Url.Action("CreateCampaign", "Admin")" class="btn btn-success">
            <i class="fas fa-plus"></i> Create New Campaign
        </a>
    </div>

    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Duration</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var campaign in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(campaign.ImageUrl))
                            {
                                var imagePath = Url.Content("~/" + campaign.ImageUrl);
                                <img src="@imagePath" alt="@campaign.Title" class="table-image" />
                            }
                        </td>
                        <td>
                            <strong>@campaign.Title</strong>
                        </td>
                        <td>@(campaign.Description?.Length > 50 ? campaign.Description.Substring(0, 50) + "..." : campaign.Description)</td>
                        <td>@campaign.DurationText</td>
                        <td>
                            @if (campaign.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div style="display: flex; gap: 5px;">
                                <a href="@Url.Action("EditCampaign", new { id = campaign.CampaignID })" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                @using (Html.BeginForm("DeleteCampaign", "Admin", new { id = campaign.CampaignID }, FormMethod.Post, new { @class = "inline-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this campaign?')">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>