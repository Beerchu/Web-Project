@model FiveStars.Models.Showings

@{
    ViewBag.Title = "Add New Showtime";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Add New Showtime</h1>
        <a href="@Url.Action("Showtimes", "Admin")" class="back-link">
            <i class="fas fa-arrow-left"></i> Back to Showtimes
        </a>
    </div>

    <div class="form-container">
        @using (Html.BeginForm("CreateShowtime", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Movie *</label>
                    @Html.DropDownList("MovieID", (SelectList)ViewBag.MoviesList, "Select Movie", new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.MovieID, "", new { style = "color: #dc3545; font-size: 12px;" })
                </div>
                <div class="form-group">
                    <label class="form-label">Hall *</label>
                    @Html.DropDownList("HallID", (SelectList)ViewBag.HallsList, "Select Hall", new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.HallID, "", new { style = "color: #dc3545; font-size: 12px;" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Show Time *</label>
                    @Html.TextBoxFor(m => m.ShowTime, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", required = "required" })
                    @Html.ValidationMessageFor(m => m.ShowTime, "", new { style = "color: #dc3545; font-size: 12px;" })
                </div>
                <div class="form-group">
                    <label class="form-label">Ticket Price *</label>
                    <div style="position: relative;">
                        <span style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #6c757d;">₺</span>
                        @Html.TextBoxFor(m => m.TicketPrice, new { @class = "form-control", type = "number", step = "0.01", required = "required", style = "padding-left: 30px;" })
                    </div>
                    @Html.ValidationMessageFor(m => m.TicketPrice, "", new { style = "color: #dc3545; font-size: 12px;" })
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Showtime
                </button>
                <a href="@Url.Action("Showtimes", "Admin")" class="btn btn-secondary">Cancel</a>
            </div>
        }
    </div>
</div>