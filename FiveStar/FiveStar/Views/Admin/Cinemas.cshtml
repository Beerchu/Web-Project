@model IEnumerable<FiveStars.Models.Cinemas>
@using System
@using System.Linq

@{ ViewBag.Title = "Cinema Management";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Cinema Management</h1>
        <a href="@Url.Action("Index", "Admin")" class="back-link">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
<div class="admin-alert success">
    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
</div>}

    @if (TempData["ErrorMessage"] != null)
    {
<div class="admin-alert error">
    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
</div>}

    <div class="action-buttons">
        <a href="@Url.Action("CreateCinema", "Admin")" class="btn btn-success">
            <i class="fas fa-plus"></i> Add New Cinema
        </a>
    </div>

    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>City</th>
                    <th>District</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cinema in Model)
                {
    <tr>
        <td>
            <strong>@cinema.CinemaName</strong>

            <!-- Hall badges shown under cinema name -->
            <div class="hall-badges">
                @if (cinema.Halls != null && cinema.Halls.Any())
                {
                    foreach (var h in cinema.Halls.OrderBy(x => x.HallID))
                    {
                        var type = (h.HallType ?? "").Trim();
                        var css = "hall-badge";

                        if (type.Equals("VIP", StringComparison.OrdinalIgnoreCase))
                        {
                            css += " hall-vip";
                        }
                        else if (type.Equals("IMAX", StringComparison.OrdinalIgnoreCase))
                        {
                            css += " hall-imax";
                        }
                        else
                        {
                            css += " hall-standard";
                        }

                        <span class="@css">#@h.HallID: @type-@(h.Capacity ?? 0)</span>
                    }
                }
                else
                {
                    <span class="hall-badge hall-empty">No halls</span>
                }
            </div>
        </td>
        <td>@cinema.City</td>
        <td>@cinema.District</td>
        <td>@cinema.PhoneNumber</td>
        <td>
            <div style="display: flex; gap: 5px;">
                <a href="@Url.Action("EditCinema", new { id = cinema.CinemaID })"
                   class="btn btn-warning btn-sm">
                    <i class="fas fa-edit"></i> Edit
                </a>

                @using (Html.BeginForm(
                    "DeleteCinema",
                    "Admin",
                    new { id = cinema.CinemaID },
                    FormMethod.Post,
                    new { @class = "inline-form" }))
                {
@Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-danger btn-sm"
                            onclick="return confirm('Are you sure you want to delete this cinema?')">
                        <i class="fas fa-trash"></i> Delete
                    </button>}
            </div>
        </td>
    </tr>}
            </tbody>
        </table>
    </div>
</div>

<!-- Badge styles (white text + colored boxes) -->
<style>
    .hall-badges{
        margin-top: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .hall-badge{
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 10px; /* more "box" than pill */
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .3px;
        color: rgb(0 0 0);
        border: 1px solid rgba(255,255,255,.16);
        box-shadow: 0 6px 18px rgba(0,0,0,.25);
    }

    .hall-standard{ background: #f0b400; } /* gold */
    .hall-vip{ background: #e53935; }      /* red */
    .hall-imax{ background: #7c3aed; }     /* purple */
    .hall-empty{ background: rgba(255,255,255,.18); }
</style>
