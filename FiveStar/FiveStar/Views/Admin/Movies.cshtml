@model IEnumerable<FiveStars.Models.Movies>

@{ ViewBag.Title = "Movie Management";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Movie Management</h1>
        <a href="@Url.Action("Index", "Admin")" class="back-link">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
<div class="admin-alert success">
    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
</div>}

    @if (TempData["ErrorMessage"] != null)
    {
<div class="admin-alert error">
    <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
</div>}

    <div class="action-buttons">
        <a href="@Url.Action("CreateMovie", "Admin")" class="btn btn-success">
            <i class="fas fa-plus"></i> Create New Movie
        </a>
    </div>

    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Poster</th>
                    <th>Title</th>
                    <th>Duration</th>
                    <th>Rating</th>
                    <th>Status</th>
                    <th>Release Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in Model)
                {
    <tr>
        <td>
            @{ var posterPath = Url.Content("~/" + (string.IsNullOrEmpty(movie.PosterUrl)
                                    ? "images/default-poster.jpg"
                                    : movie.PosterUrl)); }

            @if (!string.IsNullOrEmpty(movie.PosterUrl))
            {
<img src="@posterPath" alt="@movie.Title" class="table-image" /> }
                else
                {
<div style="width: 60px; height: 80px; background: rgba(255, 255, 255, 0.05); border-radius: 6px; border: 2px dashed #444; display: flex; align-items: center; justify-content: center;">
    <i class="fas fa-film" style="color: #666;"></i>
</div>}
        </td>
        <td>
            <strong>@movie.Title</strong>
            @if (!string.IsNullOrEmpty(movie.Description) && movie.Description.Length > 50)
            {
<br>
                    <small style="color: #6c757d; font-size: 12px;">@movie.Description.Substring(0, 50)...</small>}
        </td>
        <td>@(movie.Duration_min.HasValue ? $"{movie.Duration_min} min" : "-")</td>
        <td>
            @if (movie.Ratings.HasValue)
            {
<div class="rating-display">
    <i class="fas fa-star star"></i>
    <span>@movie.Ratings</span>
</div> }
                else
                {
<span>-</span>}
        </td>
        <td>
            @{ string statusClass = "badge-info";
                                if (!string.IsNullOrEmpty(movie.Status))
                                {
                                    var statusLower = movie.Status.ToLower();
                                    if (statusLower == "now showing")
                                    {
                                        statusClass = "badge-success";
                                    }
                                    else if (statusLower == "coming soon")
                                    {
                                        statusClass = "badge-warning";
                                    }
                                    else if (statusLower == "archived" || statusLower == "ended")
                                    {
                                        statusClass = "badge-secondary";
                                    }
                                } }
            <span class="badge @statusClass">@movie.Status</span>
        </td>
        <td>@(movie.ReleaseDate?.ToString("dd.MM.yyyy") ?? "-")</td>
        <td>
            <div style="display: flex; gap: 5px;">
                <a href="@Url.Action("EditMovie", new { id = movie.MovieID })" class="btn btn-warning btn-sm">
                    <i class="fas fa-edit"></i> Edit
                </a>
                @using (Html.BeginForm("DeleteMovie", "Admin", new { id = movie.MovieID }, FormMethod.Post, new { @class = "inline-form" }))
                {
@Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm"
                            onclick="return confirm('Are you sure you want to delete this movie?')">
                        <i class="fas fa-trash"></i> Delete
                    </button>}
            </div>
        </td>
    </tr>}
            </tbody>
        </table>
    </div>
</div>