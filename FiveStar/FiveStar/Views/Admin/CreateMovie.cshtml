@model FiveStars.Models.Movies

@{
    ViewBag.Title = "Create Movie";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Create New Movie</h1>
        <a href="@Url.Action("Movies", "Admin")" class="back-link">
            <i class="fas fa-arrow-left"></i> Back to Movies
        </a>
    </div>

    <div class="form-container">
        @using (Html.BeginForm("CreateMovie", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Title *</label>
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Enter movie title", required = "required" })
                @Html.ValidationMessageFor(m => m.Title, "", new { style = "color: #dc3545; font-size: 12px;" })
            </div>

            <div class="form-group">
                <label class="form-label">Description</label>
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Enter movie description...", rows = 5 })
                @Html.ValidationMessageFor(m => m.Description, "", new { style = "color: #dc3545; font-size: 12px;" })
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Duration (minutes)</label>
                    @Html.TextBoxFor(m => m.Duration_min, new { @class = "form-control", type = "number", placeholder = "120" })
                    @Html.ValidationMessageFor(m => m.Duration_min, "", new { style = "color: #dc3545; font-size: 12px;" })
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Poster URL</label>
                        <input type="text" name="PosterUrl" class="form-control" placeholder="images/movies/avatar.jpg" />
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Status</label>
                    @Html.DropDownListFor(m => m.Status, new SelectList(new[] { "Now Showing", "Coming Soon", "Ended" }), "Select Status", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Status, "", new { style = "color: #dc3545; font-size: 12px;" })
                </div>
                <div class="form-group">
                    <label class="form-label">Rating</label>
                    @Html.TextBoxFor(m => m.Ratings, new { @class = "form-control", type = "number", step = "0.1", placeholder = "8.5" })
                    @Html.ValidationMessageFor(m => m.Ratings, "", new { style = "color: #dc3545; font-size: 12px;" })
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Release Date</label>
                @Html.TextBoxFor(m => m.ReleaseDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.ReleaseDate, "", new { style = "color: #dc3545; font-size: 12px;" })
            </div>

            <div class="form-actions">
                <input type="submit" value="Create Movie" class="btn btn-success" />
                <a href="@Url.Action("Movies", "Admin")" class="btn btn-secondary">Cancel</a>
            </div>
        }
    </div>
</div>