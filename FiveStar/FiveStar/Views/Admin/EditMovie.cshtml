@using System.Linq
@model FiveStars.Models.Movies

@{
    ViewBag.Title = "Edit Movie";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Edit Movie: @Model.Title</h1>
        <a href="@Url.Action("Movies", "Admin")" class="back-link">
            <i class="fas fa-arrow-left"></i> Back to Movies
        </a>
    </div>

    <div class="form-container">
        @using (Html.BeginForm("EditMovie", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.MovieID)

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Movie Title *</label>
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Enter movie title", required = "required" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { style = "color: #dc3545; font-size: 12px;" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Duration (minutes)</label>
                    @Html.TextBoxFor(m => m.Duration_min, new { @class = "form-control", type = "number", placeholder = "120" })
                </div>
                <div class="form-group">
                    <label class="form-label">Rating</label>
                    @{
                        var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
                        var ratingText = (Model != null && Model.Ratings.HasValue)
                            ? Model.Ratings.Value.ToString("0.#", tr)
                            : "";
                    }
                    @Html.TextBox("Ratings", ratingText, new
                    {
                        @class = "form-control",
                        type = "text",
                        inputmode = "decimal",
                        placeholder = "8,5",
                        autocomplete = "off"
                    })
                    @Html.ValidationMessageFor(m => m.Ratings, "", new { style = "color: #dc3545; font-size: 12px;" })
                    </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Status *</label>
                    @Html.DropDownListFor(m => m.Status,
     new SelectList(
         new[] { "Now Showing", "Coming Soon", "Archived" },
         Model.Status
     ),
     new { @class = "form-control" })

                    @Html.ValidationMessageFor(m => m.Status, "", new { style = "color: #dc3545; font-size: 12px;" })
                </div>
                <div class="form-group">
                    <label class="form-label">Release Date</label>
                    @Html.TextBoxFor(m => m.ReleaseDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Genres</label>

                @{ 
                    var genres = ViewBag.Genres as IEnumerable<FiveStars.Models.Genres>;
                    var selectedIds = ViewBag.SelectedGenreIds as int[] ?? new int[0];
                }

                @if (genres != null && genres.Any())
                {
                    <div class="genre-checkboxes">
                        @foreach (var g in genres)
                        {
                            var isChecked = selectedIds.Contains(g.GenreID);
                            <label class="genre-item">
                                <input type="checkbox" name="selectedGenreIds" value="@g.GenreID" @(isChecked ? "checked=\"checked\"" : "") />
                                <span>@g.Name</span>
                            </label>
                        }
                    </div>
                    <small class="help-text">You can select multiple genres.</small>
                }
                else
                {
                    <div style="color:#b9c3cf; font-size: 14px;">No genres found in database (or genres were not loaded). Please create genres first.</div>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Poster URL</label>
                @Html.TextBoxFor(m => m.PosterUrl, new { @class = "form-control", placeholder = "images/movies/avatar.jpg" })

                @if (!string.IsNullOrEmpty(Model.PosterUrl))
                {
                    var posterPath = Url.Content("~/" + Model.PosterUrl);
                    <div class="image-preview">
                        <p style="margin: 0 0 10px 0; color: #b9c3cf;">Current poster:</p>
                        <img src="@posterPath" alt="@Model.Title" />
                    </div>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Description</label>
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Enter movie description...", rows = 5 })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Update Movie
                </button>
                <a href="@Url.Action("Movies", "Admin")" class="btn btn-secondary">Cancel</a>
            </div>
        }
    </div>
</div>
